# Copia este ficheiro para .env e preenche os valores

# URL de ligação ao MongoDB
# Em desenvolvimento local usa mongodb://localhost:27017
MONGO_URL=mongodb://localhost:27017

# Nome da base de dados no MongoDB
DB_NAME=nome_da_base_de_dados

# URL base do site (usado para SEO e partilha em redes sociais)
# Em desenvolvimento: http://localhost:3000
# Em produção: https://o-teu-dominio.pt
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Origens permitidas para aceder à API (separadas por vírgula)
# Em desenvolvimento: http://localhost:3000
# Em produção: https://o-teu-dominio.pt
CORS_ORIGINS=http://localhost:3000
